# Copy this to .env.local and fill in your values (see README step 3).
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# Optional (README step 6): Home Screen widget, needs a paid Apple Developer account.
# QUENCHIE_WIDGET=1
# APPLE_TEAM_ID=YOURTEAMID

# Optional: use your own bundle identifier if the default is taken.
# QUENCHIE_BUNDLE_ID=com.yourname.quenchie
